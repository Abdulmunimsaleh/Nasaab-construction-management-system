# NASAAB Construction API Server — Environment Configuration
# Copy this file to server/.env and fill in your private local database credentials.
# DO NOT commit server/.env to version control.

# Database Configuration (XAMPP MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nasaab_construction
DB_USER=root
DB_PASSWORD=

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret (Generate a strong random string for production)
SESSION_SECRET=nasaab_session_secret_replace_in_production_key_928374
